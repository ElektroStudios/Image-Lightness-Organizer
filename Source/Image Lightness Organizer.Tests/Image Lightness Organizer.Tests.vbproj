<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ImageLightnessOrganizer.Tests</RootNamespace>
    <AssemblyName>Image_Lightness_Organizer.Tests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>AnyCPU</Platforms>
    <NeutralLanguage>en</NeutralLanguage>
    <Copyright>ElektroStudios 2026</Copyright>
    <Company>ElektroStudios</Company>
    <Authors>ElektroStudios</Authors>
    <Product>Image Lightness Organizer</Product>
    <Description>Unit and integration tests for Image Lightness Organizer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Image Lightness Organizer\Image Lightness Organizer.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
